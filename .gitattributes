# Keep the working copy byte-identical to what is stored, so a checkout on
# Windows does not make every file look modified. Only real diffs show up.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Generated charts are text, but reviewing their diffs is never useful.
docs/*.svg linguist-generated=true
docs/index.html linguist-generated=true
results/*.json linguist-generated=true
